<UserControl x:Class="FluentFlyout.Controls.MonitorSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignWidth="760" d:DesignHeight="260">
    <Border CornerRadius="8"
            Background="#181818"
            BorderBrush="#2E2E2E"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="176" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top subtle instruction bar (like Windows Display Settings) -->
            <TextBlock Grid.Row="0"
                       x:Name="SubtitleTextBlock"
                       Text="Select a display to change its settings. Click On/Off on any display to enable or disable it."
                       Foreground="#B5FFFFFF"
                       FontSize="12"
                       Margin="16,12,16,0"
                       TextWrapping="Wrap" />

            <!-- Spatial monitor arrangement canvas -->
            <Canvas Grid.Row="1"
                    x:Name="MonitorsCanvas"
                    Background="Transparent"
                    ClipToBounds="True"
                    Margin="12,4,12,8" />

            <!-- Bottom action bar (Selected monitor info + quick toggles + Identify + Copy to all) -->
            <Border Grid.Row="2"
                    Background="#222222"
                    BorderBrush="#2E2E2E"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="SelectedMonitorInfoText"
                                   Text="Display 1"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <WrapPanel x:Name="FeaturePillsPanel" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="ToggleWidgetButton"
                                    Click="ToggleWidgetButton_Click"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    FontSize="11.5"
                                    Cursor="Hand" />
                            <Button x:Name="ToggleVisualizerButton"
                                    Click="ToggleVisualizerButton_Click"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    FontSize="11.5"
                                    Cursor="Hand" />
                            <Button x:Name="ToggleLyricsButton"
                                    Click="ToggleLyricsButton_Click"
                                    Padding="10,4"
                                    FontSize="11.5"
                                    Cursor="Hand" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="IdentifyButton"
                                Content="Identify"
                                Click="IdentifyButton_Click"
                                Margin="0,0,8,0" />
                        <Button x:Name="CopyToAllButton"
                                Content="Copy to all monitors"
                                Click="CopyToAllButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
